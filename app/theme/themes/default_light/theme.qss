/* 默认浅色 v2 —— 现代 Web 风格（毛玻璃卡片 / 渐变 / 胶囊 Tab / 细腻滚动条） */
QMainWindow {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
    stop:0 #EEF2FF, stop:0.5 #F8FAFF, stop:1 #FDF2F8);
  color: #111827;
}
QLabel { color: #111827; }
QToolBar {
  background: rgba(255, 255, 255, 200);
  border-bottom: 1px solid #E5E7EB;
}
QTabWidget::pane { border: none; }
QTabBar::tab {
  background: transparent;
  color: #6B7280;
  padding: 8px 20px;
  margin: 2px 3px;
  border-radius: 14px;
  border: none;
  font-weight: 600;
}
QTabBar::tab:hover { background: rgba(99, 102, 241, 30); }
QTabBar::tab:selected {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
    stop:0 #6366F1, stop:1 #EC4899);
  color: white;
  font-weight: 700;
}
QPushButton {
  background: white;
  color: #111827;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  padding: 6px 16px;
  font-weight: 600;
}
QPushButton:hover {
  border: 1px solid #6366F1;
  color: #6366F1;
  background: #EEF2FF;
}
QPushButton:pressed { background: #E0E7FF; }
QPushButton:disabled { color: #9CA3AF; background: #F3F4F6; }
QComboBox, QSpinBox, QLineEdit, QPlainTextEdit {
  background: white;
  color: #111827;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  padding: 5px 10px;
}
QComboBox:hover, QSpinBox:hover, QLineEdit:hover, QPlainTextEdit:hover {
  border: 1px solid #6366F1;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
  background: white;
  border: 1px solid #E5E7EB;
  border-radius: 10px;
  selection-background-color: #EEF2FF;
  selection-color: #111827;
  outline: none;
}
QScrollArea { border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
  background: rgba(99, 102, 241, 110);
  border-radius: 5px;
  min-height: 30px;
}
QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
  background: rgba(99, 102, 241, 170);
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QFrame[frameShape="6"] {
  background: rgba(255, 255, 255, 210);
  border: 1px solid rgba(255, 255, 255, 235);
  border-radius: 16px;
}
QFrame[frameShape="6"]:hover { border: 1px solid rgba(99, 102, 241, 140); }
QToolTip {
  background: #111827;
  color: #F9FAFB;
  border: none;
  border-radius: 6px;
  padding: 5px 8px;
}
