/* 夜色手稿：深靛画布 + 奶油纸张 + 低饱和紫灰与玫瑰点缀。 */
QMainWindow { background: transparent; color: {{colors.text}}; }
QDialog { background: {{colors.background}}; color: {{colors.text}}; }
QLabel { color: {{colors.text}}; background: transparent; border: none; }
QTabWidget::pane { border: none; background: transparent; }
QTabBar::tab { background: transparent; color: {{colors.muted}}; padding: 9px 16px; margin: 2px; border-radius: 10px; }
QTabBar::tab:selected { background: {{colors.card}}; color: {{colors.primary}}; }
QTabBar::tab:hover { background: {{colors.card}}; color: {{colors.text}}; }
QPushButton { background: {{colors.card}}; color: {{colors.text}}; border: 1px solid {{colors.border}}; border-radius: 12px; }
QPushButton:hover { background: {{colors.card}}; color: {{colors.text}}; border-color: {{colors.primary}}; }
QPushButton:pressed { background: {{colors.background}}; }
QPushButton:disabled { color: {{colors.muted}}; border-color: {{colors.border}}; }
QComboBox, QSpinBox, QLineEdit, QPlainTextEdit { background: {{colors.card}}; color: {{colors.text}}; border: 1px solid {{colors.border}}; border-radius: 12px; selection-background-color: {{colors.primary}}; selection-color: {{colors.on_primary}}; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox::down-arrow { image: url({{arrow}}); width: 12px; height: 12px; }
QComboBox QAbstractItemView { background: {{colors.card}}; color: {{colors.text}}; border: 1px solid {{colors.border}}; selection-background-color: {{colors.primary}}; selection-color: {{colors.on_primary}}; }
QSpinBox::up-button, QSpinBox::down-button { border: none; width: 16px; }
QCheckBox { color: {{colors.text}}; spacing: 10px; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid {{colors.muted}}; border-radius: 5px; background: {{colors.card}}; }
QCheckBox::indicator:checked { background: {{colors.primary}}; border: 2px solid {{colors.on_primary}}; }
QCheckBox:focus { color: {{colors.primary}}; }
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: {{colors.border}}; border-radius: 3px; min-height: 30px; }
QScrollBar::handle:horizontal { background: {{colors.border}}; border-radius: 3px; min-width: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QFrame[frameShape="6"] { background: {{colors.card}}; border: 1px solid {{colors.border}}; border-radius: 16px; }
QToolTip { background: {{colors.card}}; color: {{colors.text}}; border: 1px solid {{colors.border}}; padding: 6px 10px; }
